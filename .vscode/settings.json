    "string_view": "cpp",
    "iosfwd": "cpp",
    "numeric": "cpp",
    "functional": "cpp",
    "regex": "cpp",
    "tuple": "cpp",
    "bitset": "cpp"
  },
  "frontMatter.content.autoUpdateDate": true,
  "yaml.schemas": {
    "https://json.schemastore.org/github-workflow.json": "file:///home/tooster/workspace/ttr/T3sT3ro.github.io/eleventy-gh/.github/workflows/build.yml"
  },
  "svg.preview.background": "dark-transparent",
  "[markdown]": {},
