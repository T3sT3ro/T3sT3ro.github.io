    "node_modules/open-props/media.min.css",
    "src/styles/palettes.css",
    "src/styles/theme-dark.css",
    "src/styles/theme-light.css",
    "src/styles/theme.css",
  ],
  // Do not ignore node_modules css files, which is ignored by default
