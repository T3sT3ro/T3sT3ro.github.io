{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run npm start",
      "command": "npm start",
      "request": "launch",
      "type": "node-terminal",
    },
    {
      "name": "Astro Dev",
      "command": "pnpm astro dev",
      "request": "launch",
      "type": "node-terminal",
    },
    {
      "name": "Vitest current file",
      "command": "pnpm vitest ${file}",
      "request": "launch",
      "type": "node-terminal",
    },
    {
      "name": "Open factorio-waypoints.html",
      "type": "chrome",
      "request": "launch",
      "file": "/home/tooster/workspace/ttr/T3sT3ro.github.io/stuff/factorio-waypoints.html"
    },
    {
      "name": "g++ - Build and debug active file",
      "type": "cppdbg",
      "request": "launch",
      "program": "${fileDirname}/${fileBasenameNoExtension}",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "externalConsole": false,
      "MIMode": "gdb",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ],
      "preLaunchTask": "C/C++: g++ build active file",
      "miDebuggerPath": "/usr/bin/gdb"
    },
    {
      "name": "Node.js - launch current file",
      "program": "${file}",
      "request": "launch",
      "skipFiles": [
        "<node_internals>/**",
        "**/lodash/**"
      ],
      "type": "node",
      "cwd": "${fileDirname}"
    },
    { // TS-node
      "name": "TS-node - launch current file",
      "program": "${file}",
      "request": "launch",
      "skipFiles": [
        "<node_internals>/**",
        "**/lodash/**"
      ],
      "type": "node",
      "cwd": "${fileDirname}",
      "runtimeArgs": [
        "-r",
        "ts-node/register"
      ]
    }
  ]
}