---
import type { CollectionEntry } from "astro:content";
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Post from "../components/Post.astro";
import GiscusComments from '../components/GiscusComments.astro';
import FloatingControls from '../components/FloatingWidget.astro';
import MainShell from './MainLayout.astro';
import Card from '../components/Card.astro';

type Props = CollectionEntry<"blog">["data"];

const { title, description, pubDate, modDate, heroImage} = Astro.props;
---

<MainShell title={title} description={description} >
	<Card>
		<Post >
			<slot/>
		</Post>
	</Card>

	<Card>
		<GiscusComments />
	</Card>
</MainShell>