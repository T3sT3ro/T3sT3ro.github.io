---
export interface Props {
  globalShortcuts?: ;
}

const { showShortcuts: help } = Astro.props;
---

<div class="shortcuts">
  <a href="#" title="back to top"><i class="fa-regular fa-chevron-up fa-fw"></i></a>
  <a href="https://github.com/T3sT3ro" title="Visit my github!"><i class="fa-brands fa-github fa-fw"></i></a>

  {
        { help } && (
            <div class="help">
                <i class="fa-solid fa-question fa-fw" />
                <pre>
                    Shortcuts for codeblocks (hovered or for all with SHIFT) [L] - toggle line numbers [W] - wrap long
                    lines [F] - fit codeblock to window size [R] - reset properties [CTRL+A] - copy all code in
                    codeblock
                </pre>
            </div>
        )
    }
</div>

<style>
  .shortcuts {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    font-size: 2rem;

    position: fixed;
    bottom: 0.5em;
    right: 0.7em;

    background-color: #0008;

