---
export interface Props {
  name: string;
}

const { name } = Astro.props;
---

<span><a href=`/tags/${name}`>{name}</a></span>

<style>
  span {
    margin: 0 0.2em;
    border: 1px solid var(--th-P-dark);
    border-radius: 2px;
    padding: 1px 6px;
    min-width: 2em;
    text-align: center;
  }
</style>
